# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Public site address used for canonical URLs, Open Graph, sitemap and JSON-LD.
# Optional: defaults to https://salmanfaris.online.
NEXT_PUBLIC_SITE_URL=https://salmanfaris.online

# Google Search Console HTML-tag verification code (server-only). Optional.
GOOGLE_SITE_VERIFICATION=

# Enquiry form via Resend (server-only). Leave empty to show the email fallback instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Portfolio <hello@salmanfaris.online>".
CONTACT_FROM_EMAIL=
